NVIDIA_API_KEY=nvapi-...
PREP_MODEL=deepseek-ai/deepseek-v4-pro-0813
GITHUB_TOKEN=ghp_...
TAVILY_API_KEY=tvly-...

# --- Auth / database ---
# app/config.py reads these through get_secret(), which walks up from app/ and
# takes the first .env it finds - so this can live here or in the folder above.

# Where the frontend runs. Used for the CORS allow-list. 5200, not 5173 -
# vite.config.js pins that port.
ORIGIN=http://localhost:5200

# Signs the JWTs. Any long random string; generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Use a different value in every environment, and never commit the real one.
SECRET_KEY=replace-me-with-a-long-random-string

# SQLAlchemy connection URL. The default is a local SQLite file, created by
# `alembic upgrade head`. The relative path is resolved from wherever you start
# the app, so always run from the project root.
DB_URL=sqlite:///./prepgraph.db

# JWT signing algorithm. HS256 goes with the shared SECRET_KEY above.
ALGORITHM=HS256

# How long a token lasts after login, in minutes. Optional - defaults to 30.
TOKEN_MINUTES=30

# --- OCR (optional) ---
# Only needed for scanned PDFs, and only with `uv sync --group ocr`.
# The Windows installer does NOT put Tesseract on PATH, so point at the exe.
# Leave it out on a machine where `tesseract` is already on PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
