# Backend URL. Leave it empty and the Vite dev proxy sends /api to FastAPI.
VITE_API_BASE_URL=

# Where the dev proxy points (only vite.config.js reads it).
VITE_PROXY_TARGET=http://127.0.0.1:8000

# true = fake backend (src/api/mock.js). Set it to false once the Python API is ready.
VITE_USE_MOCK=true
