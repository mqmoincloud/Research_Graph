# Backend ka URL. Khaali chhodo to Vite dev proxy /api ko FastAPI par bhej dega.
VITE_API_BASE_URL=

# Dev proxy kahan point kare (sirf vite.config.js padhta hai).
VITE_PROXY_TARGET=http://127.0.0.1:8000

# true = fake backend (src/api/mock.js). Python API ready ho jaye to false kar dena.
VITE_USE_MOCK=true
