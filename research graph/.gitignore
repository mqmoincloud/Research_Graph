# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets - these must never be committed
.env
.env.*
!.env.example
apikey.md

# Node / frontend
node_modules/
dist/

# SQLite database - created by `alembic upgrade head`, never committed.
# WAL mode writes two sidecar files next to it, and *.db misses both.
*.db
*.db-wal
*.db-shm
